# keys and stuff
source ~/.secrets

# alias cdmisc="cd ~/code/misc"

export XDG_CONFIG_HOME="$HOME/dotfiles"
export KUBECONFIG=~/.foundry/kubeconfig

if [ -f /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f ~/.local/opt/brew/bin/brew ]; then
  eval "$(~/.local/opt/brew/bin/brew shellenv)"
fi

export SSH_AUTH_SOCK=~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock
export OPENAI_API_KEY="TEST"

source ~/.config/envman/PATH.env

# PATH=$PATH:$HOME/code/google-cloud-sdk/bin/
export PATH="$PATH:$HOME/nvim-macos-arm64/bin/"
export PATH="$PATH:/Applications/Tailscale.app/Contents/MacOS"

export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm

