{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "model": "ray/deepseek-ai/DeepSeek-V4-Flash-0731",
  "instructions": [
    "CLAUDE.md"
  ],
  "env": {
    "KUBECONFIG": "~/.foundry/kubeconfig"
  },
  "permission": {
    "skill": {
      "draft-plan": "allow",
      "write": "allow",
      "editor": "allow"
    }
  },
  "command": {
    "save-session": {
      "template": "Save the important information from this session to memory. Run: ~/code/opensource/experiments/scripts/save-session.sh $SESSION_ID $TRANSCRIPT_PATH",
      "description": "Save session to memory systems"
    }
  },
  "formatter": {
    "goimports": {
      "command": [
        "goimports",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".go"
      ]
    }
  },
  "lsp": {
    "go": {
      "command": [
        "gopls"
      ],
      "extensions": [
        ".go"
      ],
      "env": {
        "GOTOOLCHAIN": "go1.24.5"
      }
    },
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx"
      ]
    },
    "nix": {
      "command": [
        "nil"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "provider": {
    "ray": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Spark Cluster (spark-f5ea)",
      "options": {
        "baseURL": "http://100.87.122.108:8000/v1",
        "apiKey": "fake"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    },
    "pedrogpt": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "pedrogpt via MagicDNS (other tailnet, llama.cpp RTX 5090)",
      "options": {
        "baseURL": "http://pedrogpt:8000/v1",
        "apiKey": "fake"
      },
      "models": {
        "qwen3.6-27b-mtp": {
          "name": "Qwen3.6 27B (MTP)",
          "limit": {
            "context": 216064,
            "output": 32000
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    },
    "pedrogpt-haikei": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "pedrogpt via haikei tailnet (llama.cpp, RTX 5090)",
      "options": {
        "baseURL": "http://100.121.229.113:8000/v1",
        "apiKey": "fake"
      },
      "models": {
        "qwen3.6-27b-mtp": {
          "name": "Qwen3.6 27B (MTP, haikei)",
          "limit": {
            "context": 216064,
            "output": 32000
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (haikei)",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    }
  }
}
