# Deploy to /etc/default/vllm-cluster on spark-f5ea to pick the served model.
# Only one model runs at a time — these checkpoints cannot share 128GB/node.
# Switch with:
#   sudo systemctl stop vllm-cluster
#   sudo vi /etc/default/vllm-cluster      # change START_SCRIPT
#   sudo systemctl start vllm-cluster

# DeepSeek-V4-Flash, NON-B12X: Ray executor, stock container, no MoE backend
# flags, 3 env vars. The conservative DeepSeek path.
START_SCRIPT=/home/soypete/start-cluster-deepseek-ray.sh

# DeepSeek-V4-Flash-0731 (284B MoE, tp=2) — NVIDIA's EXPERIMENTAL B12X stack:
# b12x container, B12X_MLA_SPARSE attention, b12x MoE/linear, dspark spec
# decoding, 16 B12X env vars, and NO Ray (MultiprocExecutor + NCCL).
#START_SCRIPT=/home/soypete/start-cluster-deepseek.sh

# MiniMax-M2.5-AWQ — known-good fallback (Ray, stock container, no experimental
# anything). Weights already cached on both nodes.
#START_SCRIPT=/home/soypete/start-cluster.sh
